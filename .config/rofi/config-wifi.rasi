/* Menu wifi (networkmanager-dmenu) - variante compacte, centrée à l'écran.
   Même DA neobrutalism que swaync (SUPER+N) : bordure faux noir, ombre
   dure faux noir décalée bas/droite, fond opaque, sélection fuchsia. */

@import "colors.rasi"

* {
    background-color: transparent;
    text-color:       @fg0;
}

window {
    /* Couche d'ombre : fond plein faux noir, sans bordure, qui dépasse
       derrière mainbox via un padding asymétrique (bas/droite). Même
       technique que le lanceur principal (config.rasi). */
    transparency:  "real";
    location:      center;
    anchor:        center;
    background-color: @fauxnoir;
    border:           0px;
    border-radius:    4px 10px 4px 10px;
    width:            320px;
    padding:          0px 10px 10px 0px;
    font:             "JetBrainsMono Nerd Font Mono 11";
}

mainbox {
    background-color: @bg0;
    border:           3px;
    border-color:     @fauxnoir;
    border-radius:    4px;
    children: [ inputbar, listview ];
    spacing:  10px;
    padding:  10px;
}

inputbar {
    background-color: @bg1;
    border:            2px;
    border-color:      @fauxnoir;
    border-radius:     4px;
    padding:           8px 12px;
    children:          [ entry ];
}

entry {
    placeholder-color: @fg1;
    border:            0px;
}

listview {
    lines:    8;
    spacing:  4px;
    scrollbar: false;
    border:   0px;
}

element {
    padding:       6px 10px;
    border:        2px;
    border-color:  transparent;
    border-radius: 4px;
}

element normal.normal,
element normal.active,
element normal.urgent,
element alternate.normal,
element alternate.active,
element alternate.urgent {
    background-color: transparent;
    text-color:        @fg0;
}

element selected,
element selected.normal,
element selected.active,
element selected.urgent {
    background-color: @accent;
    text-color:        @bg0;
    border-color:      @fauxnoir;
}
