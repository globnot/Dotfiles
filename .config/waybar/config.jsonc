{
    "layer": "top",
    "position": "top",
    "height": 40,
    "spacing": 4,
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "custom/notification",
        "cpu",
        "temperature",
        "memory",
        "custom/fan",
        "disk",
        "battery",
        "network",
        "custom/vpn",
        "custom/bluetooth",
        "tray"
    ],
    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "persistent-workspaces": {
            "*": [
                1,
                2,
                3,
                4,
                5
            ]
        }
    },
    "clock": {
        "format": "{:%H:%M   %a %d %b}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "network": {
        // Épingle le module sur l'interface wifi : sans ça, la fausse
        // interface créée par ProtonVPN pour bloquer les fuites IPv6
        // ("ipv6leakintrf0", pas classée wifi/ethernet) devient
        // l'interface suivie et son nom brut s'affiche tel quel. Un glob
        // "[ew]*" (wifi + ethernet) matchait aussi le port ethernet
        // physique (débranché, donc vu comme déconnecté), ce qui masquait
        // le wifi réellement actif.
        "interface": "wl*",
        // Filet de s\u00e9curit\u00e9 g\u00e9n\u00e9rique : si l'interface wifi existe mais
        // que waybar n'arrive pas \u00e0 la classer proprement (ex. radio
        // coup\u00e9e par rfkill/mode avion), il retombe sinon sur le nom brut
        // de l'interface au lieu d'une des ic\u00f4nes ci-dessous.
        "format": "\udb82\udd2d",
        "format-wifi": "{icon}",
        "format-ethernet": "\uf0c1",
        "format-disconnected": "\udb82\udd2d",
        "format-icons": {
            "wifi": ["\udb82\udd2f", "\udb82\udd1f", "\udb82\udd22", "\udb82\udd25", "\udb82\udd28"]
        },
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}",
        "on-click": "networkmanager_dmenu"
    },
    "custom/vpn": {
        "exec": "$HOME/.config/waybar/scripts/vpn-status.sh",
        "return-type": "json",
        "interval": 5,
        "on-click": "protonvpn-app"
    },
    "battery": {
        "bat": "BAT0",
        "states": {
            "medium": 50,
            "warning": 25,
            "critical": 10
        },
        "format": "<span foreground='#928374'>BAT</span> {capacity}%",
        "format-charging": "<span foreground='#928374'>BAT</span> {capacity}%",
        "tooltip-format": "{capacity}%"
    },
    "tray": {
        "spacing": 8
    },
    "custom/notification": {
        "tooltip": true,
        "format": " ",
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    "custom/bluetooth": {
        "exec": "$HOME/.config/waybar/scripts/bluetooth-status.sh",
        "return-type": "json",
        "interval": 5,
        "on-click": "blueman-manager"
    },
    "cpu": {
        "format": "<span foreground='#928374'>CPU</span> {usage}%",
        "tooltip-format": "CPU : {usage}% ({avg_frequency} GHz)",
        "interval": 2,
        "states": {
            "warning": 70,
            "critical": 90
        }
    },
    "memory": {
        "format": "<span foreground='#928374'>RAM</span> {percentage}%",
        "tooltip-format": "{used:0.1f} Go / {total:0.1f} Go ({percentage}%)",
        "interval": 2,
        "states": {
            "warning": 70,
            "critical": 90
        }
    },
    "temperature": {
        // Capteur k10temp (Tctl). Le numéro hwmonN n'est pas garanti stable
        // (ordre de sondage du noyau) : si ce module se désactive après un
        // reboot/update noyau, vérifier le bon index avec
        // `sensors` (section k10temp-pci-*) et `cat /sys/class/hwmon/hwmon*/name`.
        // hwmon-path-abs (chemin PCI, sensé être stable) a été testé ici et
        // ne marche pas avec cette version de waybar (le module se
        // désactive, "Can't open .../hwmon/temp1_input" : waybar ne résout
        // pas le sous-dossier hwmonN malgré ce que dit sa doc), d'où le
        // retour à hwmon-path.
        "hwmon-path": "/sys/class/hwmon/hwmon7/temp1_input",
        "format": "<span foreground='#928374'>TEMP</span> {temperatureC}\u00b0C",
        "critical-threshold": 85,
        "format-critical": "<span foreground='#928374'>TEMP</span> {temperatureC}\u00b0C",
        "tooltip-format": "Temp\u00e9rature CPU : {temperatureC}\u00b0C",
        "interval": 2
    },
    "custom/fan": {
        "exec": "$HOME/.config/waybar/scripts/fan-status.sh",
        "return-type": "json",
        "interval": 2,
        "tooltip": false
    },
    "disk": {
        "format": "<span foreground='#928374'>DISK</span> {free}",
        "tooltip-format": "{path} : {free} libre / {total}",
        "paths": [
            "/"
        ],
        "interval": 60,
        "states": {
            "warning": 80,
            "critical": 90
        }
    }
}
