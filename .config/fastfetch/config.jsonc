// Généré par theme/generate.sh à partir de theme/palette.sh, ne pas éditer
// à la main. Lancé via l'alias `ff` (voir .zshrc).
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "color": { "1": "38;2;233;30;140", "2": "38;2;233;30;140" },
        "padding": { "top": 2, "left": 1 }
    },
    "modules": [
        "break",
        { "type": "custom", "format": "\u001b[38;2;29;32;33m── Matériel ──" },
        { "type": "host",      "key": " PC",  "keyColor": "38;2;233;30;140" },
        { "type": "cpu",       "key": " CPU", "keyColor": "38;2;233;30;140" },
        { "type": "gpu",       "key": "󰍛 GPU", "keyColor": "38;2;233;30;140" },
        { "type": "memory",    "key": " RAM", "keyColor": "38;2;233;30;140" },
        { "type": "disk",      "key": " Disque", "keyColor": "38;2;233;30;140" },
        "break",
        { "type": "custom", "format": "\u001b[38;2;29;32;33m── Logiciel ──" },
        { "type": "os",        "key": " OS",      "keyColor": "38;2;233;30;140" },
        { "type": "kernel",    "key": " Kernel",  "keyColor": "38;2;233;30;140" },
        { "type": "uptime",    "key": " Uptime",  "keyColor": "38;2;233;30;140" },
        { "type": "packages",  "key": "󰏖 Paquets", "keyColor": "38;2;233;30;140" },
        { "type": "shell",     "key": " Shell",   "keyColor": "38;2;233;30;140" },
        { "type": "wm",        "key": " WM",      "keyColor": "38;2;233;30;140" },
        { "type": "terminal",  "key": " Terminal","keyColor": "38;2;233;30;140" },
        "break",
        { "type": "colors", "paddingLeft": 2 }
    ]
}
