{
    "layer": "top",
    "position": "top",
    "height": 40,
    "spacing": 4,
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "custom/notification",
        "cpu",
        "temperature",
        "memory",
        "custom/fan",
        "disk",
        "battery",
        "network",
        "bluetooth",
        "tray"
    ],
    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "persistent-workspaces": {
            "*": [
                1,
                2,
                3,
                4,
                5
            ]
        }
    },
    "clock": {
        "format": "{:%H:%M   %a %d %b}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "network": {
        "format-wifi": "{icon}",
        "format-ethernet": "\uf0c1",
        "format-disconnected": "\udb82\udd2d",
        "format-icons": {
            "wifi": ["\udb82\udd2f", "\udb82\udd1f", "\udb82\udd22", "\udb82\udd25", "\udb82\udd28"]
        },
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}",
        "on-click": "networkmanager_dmenu"
    },
    "battery": {
        "bat": "BAT0",
        "states": {
            "medium": 50,
            "warning": 25,
            "critical": 10
        },
        "format": "<span foreground='#928374'>BAT</span> {capacity}%",
        "format-charging": "<span foreground='#928374'>BAT</span> {capacity}%",
        "tooltip-format": "{capacity}%"
    },
    "tray": {
        "spacing": 8
    },
    "custom/notification": {
        "tooltip": true,
        "format": " ",
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    "bluetooth": {
        "format": "\uf293",
        "format-disabled": "\uf293",
        "format-connected": "\uf293 {num_connections}",
        "tooltip-format": "Bluetooth: {status}",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "blueman-manager"
    },
    "cpu": {
        "format": "<span foreground='#928374'>CPU</span> {usage}%",
        "tooltip-format": "CPU : {usage}% ({avg_frequency} GHz)",
        "interval": 2,
        "states": {
            "warning": 70,
            "critical": 90
        }
    },
    "memory": {
        "format": "<span foreground='#928374'>RAM</span> {percentage}%",
        "tooltip-format": "{used:0.1f} Go / {total:0.1f} Go ({percentage}%)",
        "interval": 2,
        "states": {
            "warning": 70,
            "critical": 90
        }
    },
    "temperature": {
        "hwmon-path": "/sys/class/hwmon/hwmon7/temp1_input",
        "format": "<span foreground='#928374'>TEMP</span> {temperatureC}\u00b0C",
        "critical-threshold": 85,
        "format-critical": "<span foreground='#928374'>TEMP</span> {temperatureC}\u00b0C",
        "tooltip-format": "Temp\u00e9rature CPU : {temperatureC}\u00b0C",
        "interval": 2
    },
    "custom/fan": {
        "exec": "$HOME/.config/waybar/scripts/fan-status.sh",
        "return-type": "json",
        "interval": 2,
        "tooltip": false
    },
    "disk": {
        "format": "<span foreground='#928374'>DISK</span> {free}",
        "tooltip-format": "{path} : {free} libre / {total}",
        "paths": [
            "/"
        ],
        "interval": 60,
        "states": {
            "warning": 80,
            "critical": 90
        }
    }
}
