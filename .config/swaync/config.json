{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "positionX": "center",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "layer-shell-cover-screen": false,
  "cssPriority": "user",
  "control-center-margin-top": 30,
  "control-center-margin-bottom": 30,
  "control-center-margin-right": 10,
  "control-center-margin-left": 0,
  "notification-2fa-action": true,
  "notification-inline-replies": false,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "timeout": 10,
  "timeout-low": 5,
  "timeout-critical": 0,
  "fit-to-screen": false,
  "relative-timestamps": true,
  "control-center-width": 500,
  "control-center-height": 780,
  "notification-window-width": 500,
  "keyboard-shortcuts": true,
  "notification-grouping": true,
  "image-visibility": "always",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "text-empty": "No Notifications",
  "script-fail-notify": true,
  "scripts": {
    "example-script": {
      "app-name": "example.app.id",
      "exec": "echo 'Do something...'",
      "urgency": "Normal"
    },
    "example-action-script": {
      "app-name": "example.app.id",
      "exec": "echo 'Do something actionable!'",
      "urgency": "Normal",
      "run-on": "action"
    }
  },
  "notification-visibility": {
    "example-name": {
      "state": "muted",
      "urgency": "Normal",
      "app-name": "example.app.id"
    }
  },
  "widgets": [
    "inhibitors",
    "dnd",
    "buttons-grid",
    "volume",
    "backlight",
    "title",
    "notifications"
  ],
  "widget-config": {
    "notifications": {
      "vexpand": false
    },
    "inhibitors": {
      "text": "Inhibitors",
      "button-text": "Clear All",
      "clear-all-button": true
    },
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear All"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "label": {
      "max-lines": 5,
      "text": "Label Text"
    },
    "mpris": {
      "blacklist": [],
      "autohide": false,
      "show-album-art": "always",
      "loop-carousel": false
    },
    "buttons-grid": {
      "buttons-per-row": 5,
      "actions": [
        {
          "label": "\udb80\udf2a",
          "command": "sh -c 'powerprofilesctl set power-saver; $HOME/.config/swaync/scripts/update-powerprofile-state.sh'"
        },
        {
          "label": "\udb83\udf85",
          "command": "sh -c 'powerprofilesctl set balanced; $HOME/.config/swaync/scripts/update-powerprofile-state.sh'"
        },
        {
          "label": "\udb81\udcc5",
          "command": "sh -c 'powerprofilesctl set performance; $HOME/.config/swaync/scripts/update-powerprofile-state.sh'"
        },
        {
          "label": "\udb80\udc1d",
          "command": "sh -c 'rfkill list wifi | grep -q \"Soft blocked: yes\" && rfkill unblock all || rfkill block all; $HOME/.config/swaync/scripts/update-airplane-state.sh'"
        },
        {
          "label": "\udb80\udcaf",
          "command": "sh -c 'bluetoothctl show | grep -q \"Powered: yes\" && bluetoothctl power off || bluetoothctl power on; $HOME/.config/swaync/scripts/update-bluetooth-state.sh'"
        }
      ]
    },
    "volume": {
      "label": "\udb81\udd7e"
    },
    "backlight": {
      "label": "\udb80\udcdf",
      "device": "amdgpu_bl1"
    }
  }
}
