configuration {
    modi: "drun,run,window";
    show-icons: true;
    font: "JetBrainsMono Nerd Font Mono 11";
    drun-display-format: "{name}";
}

* {
    bg0:      #fbf1c7;
    bg1:      #ebdbb2;
    fg0:      #3c3836;
    fg1:      #504945;
    accent:   #e91e8c;
    fauxnoir: #1d2021;
    urgent:   #9d0006;

    background-color: transparent;
    text-color:       @fg0;
}

window {
    /* Le fond de "window" sert d'ombre dure décalée : mainbox (le vrai
       carton crème) est excentré dedans via un padding asymétrique
       (plus grand en bas/à droite), même principe que sur SDDM/Hyprland. */
    background-color: @accent;
    border:           4px;
    border-color:     @fauxnoir;
    border-radius:    3px;
    width:            30%;
    padding:          4px 10px 10px 4px;
}

mainbox {
    background-color: @bg0;
    children: [ inputbar, listview ];
    spacing:  10px;
    padding:  10px;
}

inputbar {
    background-color: @bg1;
    border:            2px;
    border-color:      @fauxnoir;
    border-radius:     3px;
    padding:           8px 12px;
    children:          [ entry ];
}

entry {
    placeholder:       "Rechercher...";
    placeholder-color: @fg1;
}

listview {
    lines:    8;
    spacing:  4px;
    scrollbar: false;
}

element {
    padding:       6px 10px;
    border:        2px;
    border-color:  transparent;
    border-radius: 3px;
}

element selected,
element selected.normal,
element selected.active,
element selected.urgent {
    background-color: @accent;
    text-color:        @bg0;
    border-color:      @fauxnoir;
}

element-icon {
    size: 1.2em;
}
